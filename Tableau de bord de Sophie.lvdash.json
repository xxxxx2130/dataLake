{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Indicateurs du dernier mois",
      "queryLines": [
        "WITH p AS (SELECT MAX(d.date) AS fin FROM workspace.gold.fait_ventes f JOIN workspace.gold.dim_date d ON d.cle_date = f.cle_date), m AS (SELECT d.nom_mois, mg.canal, SUM(f.montant) AS ca, COUNT(*) AS nb FROM workspace.gold.fait_ventes f JOIN workspace.gold.dim_date d ON d.cle_date = f.cle_date JOIN workspace.gold.dim_magasin mg ON mg.id_magasin = f.id_magasin GROUP BY d.nom_mois, mg.canal), t AS (SELECT nom_mois, SUM(ca) AS ca, SUM(nb) AS nb, SUM(CASE WHEN canal = 'WEB' THEN ca ELSE 0 END) AS ca_web FROM m GROUP BY nom_mois) SELECT a.nom_mois AS mois, ROUND(a.ca, 0) AS ca_mois, ROUND(b.ca, 0) AS ca_n1, ROUND((a.ca - b.ca) * 100 / b.ca, 1) AS evolution_pct, ROUND(a.ca / a.nb, 2) AS panier_moyen, ROUND(a.ca_web * 100 / a.ca, 1) AS part_web_pct FROM t a CROSS JOIN p JOIN t b ON b.nom_mois = date_format(add_months(p.fin, -12), 'yyyy-MM') WHERE a.nom_mois = date_format(p.fin, 'yyyy-MM')"
      ]
    },
    {
      "name": "mensuel",
      "displayName": "CA mensuel par année",
      "queryLines": [
        "SELECT CAST(d.annee AS STRING) AS annee, d.mois, ROUND(SUM(f.montant), 0) AS ca FROM workspace.gold.fait_ventes f JOIN workspace.gold.dim_date d ON d.cle_date = f.cle_date GROUP BY d.annee, d.mois"
      ]
    },
    {
      "name": "region",
      "displayName": "CA par région (12 derniers mois)",
      "queryLines": [
        "SELECT m.region, ROUND(SUM(f.montant), 0) AS ca FROM workspace.gold.fait_ventes f JOIN workspace.gold.dim_date d ON d.cle_date = f.cle_date JOIN workspace.gold.dim_magasin m ON m.id_magasin = f.id_magasin WHERE d.date > add_months((SELECT MAX(d2.date) FROM workspace.gold.dim_date d2), -12) GROUP BY m.region"
      ]
    },
    {
      "name": "magasin",
      "displayName": "Évolution par magasin (dernier mois)",
      "queryLines": [
        "WITH c AS (SELECT m.nom AS magasin, d.nom_mois, SUM(f.montant) AS ca FROM workspace.gold.fait_ventes f JOIN workspace.gold.dim_date d ON d.cle_date = f.cle_date JOIN workspace.gold.dim_magasin m ON m.id_magasin = f.id_magasin GROUP BY m.nom, d.nom_mois), p AS (SELECT MAX(date) AS fin FROM workspace.gold.dim_date) SELECT a.magasin, ROUND((a.ca - b.ca) * 100 / b.ca, 1) AS evolution_pct, ROUND(a.ca, 0) AS ca_mois FROM c a CROSS JOIN p JOIN c b ON b.magasin = a.magasin AND b.nom_mois = date_format(add_months(p.fin, -12), 'yyyy-MM') WHERE a.nom_mois = date_format(p.fin, 'yyyy-MM')"
      ]
    }
  ],
